.idea
*.iml
volumes
vault_keys.txt
*.env
.DS_Store
*.log
vault_chown.txt
volumes/minikube/

# Vault initialization files (sensitive)
minikube-local/k8s-local/.vault-init/
*.bin
*.exe

# Binaries generated during build
minikube-local/k8s-local/infras-cli/kubectl

# PostgreSQL backups
minikube-local/k8s-local/postgres/backups/
*.backup
*.sql.gz
*.dump

# MinIO: mc client binary, sync daemon pidfile, and the live host mirror data.
# The mirror dir is fully mc-managed (mirror --remove), so nothing here is
# tracked; sync.sh recreates it via mkdir -p.
minikube-local/k8s-local/minio/scripts/bin/
minikube-local/k8s-local/minio/scripts/.sync.pid
minikube-local/k8s-local/minio/volumes/
